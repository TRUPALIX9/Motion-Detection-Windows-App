<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    </startup>
    <!--
      Service settings. Leave these empty in source control and fill them in on the
      installed copy (MyService.exe.config next to MyService.exe). An environment
      variable with the name in brackets overrides each key.
    -->
    <appSettings>
        <!-- Camera stream to watch, e.g. an rtsp:// URL [ZONEWATCH_RTSP_URL] -->
        <add key="RtspInputUrl" value="" />
        <!-- Optional RTSP target to relay to while motion is present [ZONEWATCH_RELAY_URL] -->
        <add key="RelayOutputUrl" value="" />
        <!-- Optional folder containing ffmpeg.exe and ffprobe.exe; skips the download [ZONEWATCH_FFMPEG_DIR] -->
        <add key="FFmpegDirectory" value="" />
    </appSettings>
</configuration>
