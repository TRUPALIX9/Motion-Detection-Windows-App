# ZoneWatch settings. Names only: never commit real values.
# The apps read these from the process environment (for example `setx NAME value`
# in a Command Prompt, then open a new prompt). They do not load this file.
# The Windows service also reads the same keys from MyService.exe.config (appSettings).

# Camera stream, e.g. rtsp://<user>:<password>@<camera-ip>:554/<path>
# Pre-fills the main window, the forwarding tool's input and the PTZ form's motion test;
# required by the service (or set RtspInputUrl in MyService.exe.config).
ZONEWATCH_RTSP_URL=

# Optional RTSP target to relay to (forwarding tool output; service relay while motion is present).
ZONEWATCH_RELAY_URL=

# Optional pre-fill for the PTZ Controls window (ONVIF camera host or host:port and login).
ZONEWATCH_PTZ_HOST=
ZONEWATCH_PTZ_USERNAME=
ZONEWATCH_PTZ_PASSWORD=

# Optional folder containing ffmpeg.exe/ffprobe.exe for the service; skips the runtime download.
ZONEWATCH_FFMPEG_DIR=
